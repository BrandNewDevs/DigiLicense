DIGILICENSE_AI_PROFILE=production
DIGILICENSE_AI_PROVIDER_BACKEND=openai
DIGILICENSE_AI_RETRIEVAL_BACKEND=bm25
DIGILICENSE_AI_DLP_BACKEND=local
DIGILICENSE_AI_CONTEXT_BACKEND=local
DIGILICENSE_AI_INTENT_BACKEND=local
DIGILICENSE_AI_SERVICE_BEARER_TOKEN=replace-with-a-32-character-minimum-rotated-credential
DIGILICENSE_AI_OPENAI_API_KEY=replace-with-dedicated-project-key
DIGILICENSE_AI_OPENAI_PROJECT_ID=replace-with-dedicated-project-id
DIGILICENSE_AI_OPENAI_BUDGET_CONTROLS_CONFIRMED=true
DIGILICENSE_AI_REQUIRE_TLS=true
# For Render only. Other deployments must use exact proxy IPs below.
DIGILICENSE_AI_TRUST_RENDER_TLS_PROXY=false
DIGILICENSE_AI_TRUSTED_PROXY_IPS=["replace-with-reverse-proxy-ip"]
DIGILICENSE_AI_CONTEXT_SIGNING_CURRENT_KEY=replace-with-a-32-character-minimum-signing-key
DIGILICENSE_AI_EGRESS_NETWORK=digilicense-ai-egress

      "sections": [
        {
          "sectionId": "delhi-ll-validity-preparation-v1",
          "heading": "Learner licence and preparation",
          "claimKind": "public_policy",
          "text": "Delhi public guidance describes a learner licence as temporary and valid for up to six months. It also directs learners to prepare on vehicle controls, road signs, and traffic rules."
        },
        {
          "sectionId": "delhi-permanent-licence-timing-v1",
          "heading": "Permanent licence timing",
          "claimKind": "public_policy",
          "text": "Delhi public guidance says a valid learner licence must be held for at least 30 days before the competence test, and the permanent licence application should be made within six months of learner-licence issue."
        },
        {
          "sectionId": "delhi-appointments-fees-v1",
          "heading": "Appointments and fees",
          "claimKind": "public_policy",
          "text": "Delhi public guidance identifies appointment and fee payment as driving-licence service topics. Current availability, fee amounts, and any transaction must be checked in the approved public source; DigiLicense does not carry out that transaction."
        },
        {
          "sectionId": "delhi-renewal-replacement-v1",
          "heading": "Renewal and replacement",
          "claimKind": "public_policy",
          "text": "Delhi public guidance lists renewal and duplicate-licence requirements separately. This corpus is reference material only and does not determine an applicant's eligibility or submit a request."
        }
      ],

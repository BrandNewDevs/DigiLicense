generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  DOCUMENT_REVIEW
  DOCUMENTS_VERIFIED
  CORRECTION_REQUIRED
  PAYMENT_REVIEW
  PAYMENT_CONFIRMED
  TEST_PENDING
  TEST_PASSED
  TEST_FAILED
  APPROVAL_PENDING
  APPROVED
  REJECTED
  WAITLISTED
  APPOINTMENT_OFFERED
  APPOINTMENT_CONFIRMED
}

enum ApplicationBlockingReason {
  DOCUMENT_REVIEW_PENDING
  CORRECTION_REQUIRED
  PAYMENT_CONFIRMATION_PENDING
  TEST_RESULT_PENDING
  APPROVAL_REVIEW_PENDING
  APPOINTMENT_SLOT_UNAVAILABLE
  APPOINTMENT_PREFERENCES_REQUIRED
  APPOINTMENT_OFFER_ACTION_REQUIRED
  WAITING_PERIOD_NOT_MET
}

enum AppointmentSlotStatus {
  OPEN
  OFFERED
  CONFIRMED
  RETIRED
}

enum AppointmentWaitlistStatus {
  ACTIVE
  COOLDOWN
  LEFT
  CONFIRMED
}

enum AppointmentOfferStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AppointmentNotificationChannel {
  SMS
  EMAIL
}

enum AppointmentNotificationDeliveryStatus {
  RECORDED
  FAILED
}

enum TestLanguage {
  ENGLISH
  HINDI
}

enum WorkflowActor {
  APPLICANT
  OPERATOR
  SYSTEM
}

enum DocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  PHOTO
  OTHER
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum MobileChangeVerificationMethod {
  OTP
  MOCK_AADHAAR
}

enum MobileChangeStatus {
  OTP_PENDING
  AADHAAR_PENDING
  COMPLETED
  FAILED
  LOCKED
  EXPIRED
  CANCELLED
}

enum MockAadhaarVerificationStatus {
  PENDING
  PASSED
  FAILED
}

enum MockAddressProofType {
  MOCK_AADHAAR_ADDRESS_PROOF
  MOCK_RENTAL_AGREEMENT
  MOCK_UTILITY_BILL
}

enum AddressChangeVerificationStatus {
  OTP_PENDING
  OTP_VERIFIED
  LOCKED
  EXPIRED
  CONSUMED
  CANCELLED
}

model Application {
  id                String               @id @default(cuid())
  applicantId       String
  applicationNumber String               @unique
  service           String
  status            ApplicationStatus
  blockingReasonCode ApplicationBlockingReason?
  statusDeadlineAt  DateTime?
  nextAction        String
  version           Int                  @default(1)
  submittedAt       DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  workflowEvents    WorkflowEvent[]
  auditEvents       AuditEvent[]
  draft             ApplicationDraft?
  documents         DocumentRecord[]
  payments          PaymentRecord[]
  notifications     NotificationRecord[]
  learnerTestAttempts LearnerTestAttempt[]
  addressChangeDetail AddressChangeDetail?
  permanentLicenceDetail PermanentLicenceDetail?
  appointmentWaitlistEntries AppointmentWaitlistEntry[]
  confirmedAppointment ConfirmedAppointment?

  @@index([applicantId, applicationNumber])
  @@index([status, submittedAt])
  @@index([service, status, statusDeadlineAt])
}

model WorkflowEvent {
  id            String             @id @default(cuid())
  applicationId String
  actor         WorkflowActor
  actorId       String
  title         String
  description   String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

model AuditEvent {
  id            String       @id @default(cuid())
  applicationId String?
  actorId       String
  action        String
  entityType    String
  entityId      String
  reasonCode    String
  justification String?
  requestId     String
  createdAt     DateTime     @default(now())
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([createdAt])
}

model ApplicationDraft {
  id            String       @id @default(cuid())
  applicantId   String
  service       String
  formPayload   String
  applicationId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // Draft form data is temporary. The database default and update trigger in
  // the retention migration set this to seven days after the latest payload
  // save. The scheduled purge removes records once this deadline passes.
  expiresAt     DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)"))
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicantId, service, updatedAt])
  @@index([expiresAt])
}

model DocumentRecord {
  id            String         @id @default(cuid())
  applicationId String
  type          DocumentType
  status        DocumentStatus @default(UPLOADED)
  fileName      String
  reference     String         @unique
  isSimulated   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, type])
  @@index([applicationId, status])
}

model PaymentRecord {
  id             String        @id @default(cuid())
  applicationId  String
  feeLines       String
  amountPaise    Int
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  reference      String?       @unique
  isSimulated    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([applicationId, status])
}

model NotificationRecord {
  id            String             @id @default(cuid())
  applicantId   String
  applicationId String?
  title         String
  message       String
  status        NotificationStatus @default(UNREAD)
  isSimulated   Boolean            @default(true)
  createdAt     DateTime           @default(now())
  readAt        DateTime?
  application   Application?       @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicantId, status, createdAt])
  @@index([applicationId, createdAt])
}

// One row per completed learner's-test submission. Question identifiers and
// submitted answers are stored so the result is reproducible and reviewable.
model LearnerTestAttempt {
  id             String       @id @default(cuid())
  applicationId  String
  language       TestLanguage
  questionIds    String
  answers        String
  score          Int
  passed         Boolean
  // Client-generated key so a retried submission after a lost response
  // returns the stored graded result instead of recording a second attempt.
  // Uniqueness is scoped per application: keys are never matched across
  // applicants, so another applicant's key cannot leak their result.
  idempotencyKey String
  isSimulated    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId, createdAt])
}

model ApplicantAccount {
  id                      String                @id
  mobileHmac              String                @unique
  mobileHmacKeyVersion    String
  mobileLastFour          String
  authVersion             Int                   @default(1)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  mobileChangeRequests    MobileChangeRequest[]
  drivingLicenceRecords   DrivingLicenceRecord[]
  addressChangeVerifications AddressChangeVerification[]
  appointmentWaitlistEntries AppointmentWaitlistEntry[]

  @@index([updatedAt])
}

// Synthetic licence records establish server-side ownership for services that
// act on an existing driving licence. They never represent a government record.
model DrivingLicenceRecord {
  id                    String                      @id @default(cuid())
  applicantId           String
  licenceNumber         String                      @unique
  currentAddressSummary String
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  applicant             ApplicantAccount            @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  addressVerifications  AddressChangeVerification[]
  addressChangeDetails  AddressChangeDetail[]

  @@index([applicantId, licenceNumber])
}

// A short-lived step-up challenge authorizes a single address-change
// submission. Address data is not placed in this verification record.
model AddressChangeVerification {
  id                         String                          @id @default(cuid())
  applicantId                String
  licenceRecordId            String
  status                     AddressChangeVerificationStatus
  startIdempotencyKey        String                          @unique
  verificationIdempotencyKey String?                         @unique
  expiresAt                  DateTime
  verifiedAt                 DateTime?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  applicant                  ApplicantAccount                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  licenceRecord              DrivingLicenceRecord            @relation(fields: [licenceRecordId], references: [id], onDelete: Restrict)
  otpChallenge               AddressChangeOtpChallenge?

  @@index([applicantId, updatedAt])
  @@index([expiresAt])
  @@unique([applicantId], map: "AddressChangeVerification_one_active_per_applicant_key", where: raw("\"status\" IN ('OTP_PENDING'::\"AddressChangeVerificationStatus\", 'OTP_VERIFIED'::\"AddressChangeVerificationStatus\")"))
}

model AddressChangeOtpChallenge {
  id              String                    @id @default(cuid())
  verificationId  String                    @unique
  codeHash        String
  attemptCount    Int                       @default(0)
  maxAttempts     Int                       @default(5)
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime                  @default(now())
  verification    AddressChangeVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// The submitted synthetic address is scoped to an application. Updating an
// actual licence record remains an explicit future approval workflow.
model AddressChangeDetail {
  id                       String                @id @default(cuid())
  applicationId            String                @unique
  licenceRecordId          String
  proofType                MockAddressProofType
  addressLine1             String
  addressLine2             String?
  locality                 String
  pincode                  String
  submissionIdempotencyKey String                @unique
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  application              Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  licenceRecord            DrivingLicenceRecord  @relation(fields: [licenceRecordId], references: [id], onDelete: Restrict)

  @@index([licenceRecordId, createdAt])
}

model PermanentLicenceDetail {
  id                    String      @id @default(cuid())
  applicationId         String?     @unique
  applicantId           String
  learnerApplicationId  String
  vehicleClass          String
  learnerEligibilityDeadlineAt DateTime
  idempotencyKey        String
  createdAt             DateTime    @default(now())
  application           Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicantId, idempotencyKey])
  @@index([learnerApplicationId])
}

// Appointment inventory is controlled by system-only commands. Every row is
// one bookable seat, which keeps capacity and double-booking rules explicit.
model AppointmentSlot {
  id           String                @id @default(cuid())
  inventoryKey String                @unique
  zone         String
  vehicleClass String
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentSlotStatus @default(OPEN)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  offers       AppointmentOffer[]
  confirmation ConfirmedAppointment?

  @@index([status, vehicleClass, zone, startsAt])
  @@index([startsAt])
}

// A permanent-licence application can have historic entries, but only one
// entry may be eligible for allocation at a time. `originalJoinedAt` is
// deliberately retained through cooldowns so expiry does not erase fairness.
model AppointmentWaitlistEntry {
  id                 String                    @id @default(cuid())
  applicationId      String
  applicantId        String
  status             AppointmentWaitlistStatus @default(ACTIVE)
  originalJoinedAt   DateTime                  @default(now())
  availableAfter     DateTime?
  joinIdempotencyKey String                    @unique
  preferenceIdempotencyKey String?              @unique
  leaveIdempotencyKey String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  application        Application               @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicant          ApplicantAccount          @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  preferences        AppointmentPreference[]
  notificationPreferences AppointmentNotificationPreference[]
  offers             AppointmentOffer[]

  @@index([status, availableAfter, originalJoinedAt])
  @@index([applicantId, status])
  @@unique([applicationId], map: "appointment_waitlist_one_active_per_application_key", where: raw("\"status\" IN ('ACTIVE'::\"AppointmentWaitlistStatus\", 'COOLDOWN'::\"AppointmentWaitlistStatus\")"))
}

model AppointmentPreference {
  id                String                   @id @default(cuid())
  waitlistEntryId   String
  rank              Int
  zone              String
  createdAt         DateTime                 @default(now())
  waitlistEntry     AppointmentWaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)

  @@unique([waitlistEntryId, rank])
  @@unique([waitlistEntryId, zone])
  @@index([zone, rank])
}

// The selected delivery channels are retained independently from offer
// history. The alias is synthetic and opaque so this prototype never stores a
// raw mobile number or email address for notification delivery.
model AppointmentNotificationPreference {
  id                String                          @id @default(cuid())
  waitlistEntryId   String
  channel           AppointmentNotificationChannel
  recipientAlias    String
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  waitlistEntry     AppointmentWaitlistEntry       @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)

  @@unique([waitlistEntryId, channel])
}

// An offer is append-only. The score snapshot explains the allocation that
// occurred at that instant even as other candidates age in the queue later.
model AppointmentOffer {
  id                   String                  @id @default(cuid())
  slotId               String
  waitlistEntryId      String
  status               AppointmentOfferStatus  @default(ACTIVE)
  rankingPolicyVersion String
  rankingScore         Int
  rankingBreakdown     Json
  expiresAt            DateTime
  responseAt           DateTime?
  responseIdempotencyKey String?                @unique
  allocationKey        String                  @unique
  createdAt            DateTime                @default(now())
  slot                 AppointmentSlot         @relation(fields: [slotId], references: [id], onDelete: Restrict)
  waitlistEntry        AppointmentWaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Restrict)
  confirmation         ConfirmedAppointment?
  deliveries           AppointmentNotificationDelivery[]

  @@index([status, expiresAt])
  @@index([waitlistEntryId, createdAt])
  @@unique([slotId], map: "appointment_offer_one_active_per_slot_key", where: raw("\"status\" = 'ACTIVE'::\"AppointmentOfferStatus\""))
  @@unique([waitlistEntryId], map: "appointment_offer_one_active_per_entry_key", where: raw("\"status\" = 'ACTIVE'::\"AppointmentOfferStatus\""))
}

model ConfirmedAppointment {
  id                         String             @id @default(cuid())
  applicationId              String             @unique
  slotId                     String             @unique
  offerId                    String             @unique
  confirmationIdempotencyKey String             @unique
  confirmedAt                DateTime           @default(now())
  application                Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  slot                       AppointmentSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  offer                      AppointmentOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
}

// This is a provider-ready outbox, not a contact store. Recipient aliases are
// opaque synthetic fixture identifiers and no SMS or email is sent by this app.
model AppointmentNotificationDelivery {
  id             String                                @id @default(cuid())
  offerId        String
  channel        AppointmentNotificationChannel
  recipientAlias String
  status         AppointmentNotificationDeliveryStatus @default(RECORDED)
  idempotencyKey String                                @unique
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  offer          AppointmentOffer                      @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([offerId, channel])
  @@index([status, createdAt])
}

model MobileChangeRequest {
  id                         String                         @id @default(cuid())
  applicantId                String
  targetMobileHmac           String
  targetMobileHmacKeyVersion String
  targetMobileLastFour       String
  method                     MobileChangeVerificationMethod
  status                     MobileChangeStatus
  startIdempotencyKey        String                         @unique
  confirmationIdempotencyKey String?                        @unique
  expiresAt                  DateTime
  completedAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  otpChallenge               MobileChangeOtpChallenge?
  aadhaarVerification        MockAadhaarVerification?
  applicant                  ApplicantAccount               @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@index([applicantId, updatedAt])
  @@index([expiresAt])
}

model MobileChangeOtpChallenge {
  id          String              @id @default(cuid())
  requestId   String              @unique
  codeHash    String
  attemptCount Int                @default(0)
  maxAttempts Int                 @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())
  request     MobileChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MockAadhaarVerification {
  id          String                         @id @default(cuid())
  requestId   String                         @unique
  status      MockAadhaarVerificationStatus @default(PENDING)
  reasonCode  String?
  completedAt DateTime?
  createdAt   DateTime                       @default(now())
  request     MobileChangeRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// Fixed-window rate-limit counters shared across instances. Keys are hashed,
// so raw identifiers are never stored.
model RateLimitWindow {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  hits        Int      @default(0)

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
}

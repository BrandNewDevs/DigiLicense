# Local PostgreSQL connection string. Use synthetic development data only.
DATABASE_URL="postgresql://digilicense:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/digilicense?sslmode=require&uselibpqcompat=true"

# Set a unique local value before running the web app outside Docker.
DIGILICENSE_SESSION_SECRET="replace-with-a-random-session-secret-at-least-32-characters"

# Hashes synthetic mobile identifiers before they are stored or used as
# rate-limit keys. Use a distinct random value in each environment.
DIGILICENSE_IDENTIFIER_HMAC_SECRET="replace-with-a-random-hmac-secret-at-least-32-characters"

# Synthetic only: fixed OTP accepted for applicant sign-in and mobile-update
# verification. Production requires this value to be configured explicitly.
DIGILICENSE_MOCK_MOBILE_UPDATE_OTP="123456"

# Required for operator sign in. No fallback exists; without both values the
# operator login is rejected and no session is issued. Synthetic prototype
# credentials only. Do not use real staff credentials.
DEMO_OPERATOR_USERNAME="operator.demo"
DEMO_OPERATOR_PASSWORD="demo-only"

# Set to true only when the deployment sits behind a proxy that REPLACES
# (never appends to) client-supplied X-Forwarded-For values. Without that
# guarantee, login rate limiting uses the direct connection address.
DIGILICENSE_TRUST_PROXY_HEADERS="false"

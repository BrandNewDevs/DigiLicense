# Local PostgreSQL connection string. Use synthetic development data only.
DATABASE_URL="postgresql://digilicense:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/digilicense?sslmode=require&uselibpqcompat=true"

# Set a unique local value before running the web app outside Docker.
DIGILICENSE_SESSION_SECRET="replace-with-a-random-session-secret-at-least-32-characters"

# Set to true only when the deployment sits behind a proxy that REPLACES
# (never appends to) client-supplied X-Forwarded-For values. Without that
# guarantee, login rate limiting uses the direct connection address.
DIGILICENSE_TRUST_PROXY_HEADERS="false"

# Local PostgreSQL connection string. Use synthetic development data only.
DATABASE_URL="postgresql://digilicense:12345678@localhost:5432/digilicense?sslmode=require&uselibpqcompat=true"

# Local development only. Encrypts separate applicant and operator mock cookies.
# Replace with a unique secret in every deployed environment.
DIGILICENSE_SESSION_SECRET="digilicense-local-development-session-secret-2026-only"

# Required for operator sign in. No fallback exists; without both values the
# operator login is rejected and no session is issued. Synthetic prototype
# credentials only. Do not use real staff credentials.
DEMO_OPERATOR_USERNAME="operator.demo"
DEMO_OPERATOR_PASSWORD="demo-only"

# Set to true only when the deployment sits behind a proxy that REPLACES
# (never appends to) client-supplied X-Forwarded-For values. Without that
# guarantee, login rate limiting uses the direct connection address.
DIGILICENSE_TRUST_PROXY_HEADERS="false"

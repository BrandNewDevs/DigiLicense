{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "prebuild": "pnpm --filter @digilicense/db build",
    "build": "vite build && node scripts/verify-client-db-boundary.mjs",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai-integration": "vitest run --config vitest.ai-integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@digilicense/db": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.33.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.7.0",
    "srvx": "^0.12.7",
    "tailwindcss": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4.1.11"
  }
}

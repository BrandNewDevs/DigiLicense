{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "src/generated/prisma/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "db:generate": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["src/generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@digilicense/db#db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

# Used by Docker Compose for local development. Copy this file to `.env`, then
# replace the secret placeholders before starting the stack.
DIGILICENSE_LOCAL_DB_PASSWORD="replace-with-a-unique-local-database-password"
DIGILICENSE_SESSION_SECRET="replace-with-a-random-session-secret-at-least-32-characters"
DIGILICENSE_PUBLIC_ORIGIN="http://localhost:3000"
